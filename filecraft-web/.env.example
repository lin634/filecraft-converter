# filecraft-web 生产环境配置（复制为 .env 后按需修改；不要把 .env 提交/打包进代码）

# 监听地址：必须 127.0.0.1，由 Nginx 反代对外
FILECRAFT_HOST=127.0.0.1
FILECRAFT_PORT=3100

# 数据目录（上传文件、转换结果、总结）
FILECRAFT_DATA_DIR=/var/www/filecraft/data

# 大模型接口（OpenAI 兼容格式）
FILECRAFT_LLM_BASE_URL=https://api-inference.modelscope.cn/v1
FILECRAFT_LLM_API_KEY=your-api-key-here
FILECRAFT_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# 会话/工作区派生密钥（不配置则首次启动自动生成到 data/secret.txt）
# FILECRAFT_SECRET=随机长随机串

# 限制
FILECRAFT_MAX_FILE_MB=40
FILECRAFT_WORKSPACE_TTL_DAYS=7
FILECRAFT_AI_RATE_LIMIT=30
