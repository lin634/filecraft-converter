.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-label {
  flex: 1;
  min-width: 0;
}

.label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.chip {
  display: inline-block;
  background: #eff6ff;
  color: #2563eb;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin: 4rpx 8rpx 4rpx 0;
  font-size: 22rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: #9ca3af;
  font-size: 40rpx;
  padding-left: 16rpx;
}

.field {
  margin-top: 16rpx;
}

.extra {
  width: 100%;
  background: #f9fafb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 88rpx;
}

.run-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.run {
  width: 100%;
}

.progress {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-text {
  flex: 1;
  color: #2563eb;
  font-size: 26rpx;
}

.spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #dbeafe;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.logs {
  padding: 18rpx 24rpx;
}

.log {
  font-size: 24rpx;
  line-height: 1.9;
}

.seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.seg-item.on {
  background: #fff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.editor {
  width: 100%;
  min-height: 480rpx;
  font-size: 27rpx;
  line-height: 1.7;
  box-sizing: border-box;
}

.preview {
  max-height: 60vh;
  min-height: 300rpx;
}

.actions {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  padding: 0 24rpx 50rpx;
}

.act {
  padding: 0 30rpx;
}
