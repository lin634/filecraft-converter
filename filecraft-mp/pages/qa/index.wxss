page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
}

.doc-chip {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
}

.doc-names {
  font-size: 25rpx;
  color: #2563eb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: #9ca3af;
  font-size: 34rpx;
  padding-left: 12rpx;
}

.top-actions {
  display: flex;
  gap: 24rpx;
  flex-shrink: 0;
}

.link {
  color: #2563eb;
  font-size: 27rpx;
}

.chat {
  flex: 1;
  min-height: 0;
}

.chat-pad {
  height: 30rpx;
}

.msg {
  display: flex;
  padding: 14rpx 24rpx;
}

.msg.mine {
  justify-content: flex-end;
}

.bubble {
  max-width: 82%;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  font-size: 28rpx;
  word-break: break-all;
}

.bubble-me {
  background: #2563eb;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}

.bubble-bot {
  background: #fff;
  border-bottom-left-radius: 4rpx;
}

.inputbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f3f4f6;
}

.ask {
  flex: 1;
  background: #f3f4f6;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
}

.send {
  padding: 0 30rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  max-height: 75vh;
}

.head {
  display: flex;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f3f4f6;
}

.hist-body {
  max-height: 55vh;
  min-height: 240rpx;
}

.srow {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f9fafb;
}

.srow-main {
  flex: 1;
  min-width: 0;
}

.stitle {
  font-size: 29rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.smeta {
  font-size: 22rpx;
  margin-top: 4rpx;
}
