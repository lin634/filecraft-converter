page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.seg-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f3f4f6;
}

.seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 12rpx;
  padding: 4rpx;
  width: 260rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 8rpx 0;
  border-radius: 8rpx;
  font-size: 25rpx;
  color: #6b7280;
}

.seg-item.on {
  background: #fff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.08);
}

.bar-actions {
  display: flex;
  gap: 14rpx;
}

.doc {
  flex: 1;
  min-height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.raw {
  font-size: 25rpx;
  line-height: 1.7;
  word-break: break-all;
  white-space: pre-wrap;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.doc-pad {
  height: 40rpx;
}
