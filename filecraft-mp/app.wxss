/** 全局样式：与 Web 版同一套配色（primary #2563eb）。 */
page {
  background: #f3f4f6;
  color: #1f2328;
  font-size: 28rpx;
  line-height: 1.6;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background: #a5c0f5;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #2563eb;
  border: 1rpx solid #2563eb;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn-danger-ghost {
  background: #fff;
  color: #dc2626;
  border: 1rpx solid #dc2626;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.btn::after {
  border: none;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #9ca3af;
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}
